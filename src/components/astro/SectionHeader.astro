---
import Reveal from '../react/Reveal';

interface Props {
  /** Nomor section dua digit, mis. "01". */
  number: string;
  title: string;
  /** Dipakai `aria-labelledby` pada <section> pembungkus. */
  id: string;
}

const { number, title, id } = Astro.props;
---

<Reveal client:idle effect="rise" className="flex items-baseline gap-4">
  <span data-reveal-item class="text-accent font-mono text-[13px]" aria-hidden="true">
    {number}
  </span>
  <h2 data-reveal-item id={id}>
    {title}
  </h2>
</Reveal>
