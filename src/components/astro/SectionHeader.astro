---
interface Props {
  /** Nomor section dua digit, mis. "01". */
  number: string;
  title: string;
  /** Dipakai `aria-labelledby` pada <section> pembungkus. */
  id: string;
}

const { number, title, id } = Astro.props;
---

<div class="flex items-baseline gap-4">
  <span class="text-accent font-mono text-[13px]" aria-hidden="true">
    {number}
  </span>
  <h2 id={id}>{title}</h2>
</div>
