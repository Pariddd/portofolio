---
import rawData from '../../data/htb-activity.json';
import { PROFILE } from '../../data/profile';
import { heatLevel, toWeeks, type HeatLevel } from '../../lib/heatmap';
import { dailySeries, parseHtbData } from '../../lib/htb';
import CountUp from '../react/CountUp';
import Reveal from '../react/Reveal';
import Tooltip from '../react/Tooltip';
import SectionHeader from './SectionHeader.astro';

// Data ditulis scripts/sync-htb.ts (GitHub Actions, sekali sehari). File yang rusak
// dibaca sebagai data kosong, jadi build tidak gagal.
const { syncedAt, trackingSince, stats, days } = parseHtbData(rawData);
const NUMBER = new Intl.NumberFormat('id-ID');
const DAY = new Intl.DateTimeFormat('id-ID', { dateStyle: 'medium', timeZone: 'Asia/Jakarta' });

const series = dailySeries(days, new Date());
const max = Math.max(...series.map((entry) => entry.xp));
const periodXp = series.reduce((sum, entry) => sum + entry.xp, 0);
// Tiap kotak membawa teks tooltip: tanggal dan XP hari itu.
const weeks = toWeeks(
  series.map(({ day, xp }) => ({
    level: heatLevel(xp, max),
    tip: `${DAY.format(new Date(`${day}T00:00:00+07:00`))} · ${NUMBER.format(xp)} XP`,
  })),
);
const DATE = new Intl.DateTimeFormat('id-ID', { dateStyle: 'long', timeZone: 'Asia/Jakarta' });
const syncLabel =
  syncedAt === null ? 'belum tersinkron' : `diperbarui ${DATE.format(new Date(syncedAt))}`;
const sinceLabel =
  trackingSince === null ? null : DATE.format(new Date(`${trackingSince}T00:00:00+07:00`));

const STATS = [
  { label: 'LEVEL', value: stats.level, note: stats.levelTitle },
  {
    label: 'TOTAL XP',
    value: stats.totalXp,
    note: `${NUMBER.format(stats.xpToNextLevel)} XP lagi`,
  },
  { label: 'STREAK', value: stats.streak, note: `terpanjang ${NUMBER.format(stats.maxStreak)}` },
  {
    label: 'MODUL ACADEMY',
    value: stats.academyModules,
    note: `${NUMBER.format(stats.academyBadges)} badge`,
  },
];

const LEVEL_CLASS: Record<HeatLevel, string> = {
  0: 'bg-heat-0',
  1: 'bg-heat-1',
  2: 'bg-heat-2',
  3: 'bg-heat-3',
  4: 'bg-heat-4',
};
const LEVELS: readonly HeatLevel[] = [0, 1, 2, 3, 4];
const CELL_CLASS = 'rounded-heat size-3';
// Wadah yang bisa digulir harus bisa difokus keyboard (WCAG 2.1.1). Ditulis sebagai
// ekspresi karena aturan lint `no-noninteractive-tabindex` hanya menerima bentuk itu.
const SCROLLABLE_TABINDEX = 0;
---

<section id="aktivitas" aria-labelledby="judul-aktivitas" class="container-page">
  <div class="border-line border-t py-16 md:py-26">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <SectionHeader number="03" title="Aktivitas Hack The Box" id="judul-aktivitas" />
      <p class="text-faint font-mono text-[13px]">{syncLabel}</p>
    </div>

    <CountUp client:idle className="mt-7">
      <dl class="border-ink grid grid-cols-2 border-t lg:grid-cols-4">
        {STATS.map((stat) => (
          <div class="border-line flex flex-col-reverse gap-1 border-b py-5 pr-4">
            <dt class="text-faint font-mono text-[12px]">{stat.label}</dt>
            <dd>
              <span
                data-count-to={stat.value}
                class="block text-[40px] leading-none font-extrabold tracking-[-0.03em] md:text-[52px]"
              >
                {NUMBER.format(stat.value)}
              </span>
              <span class="text-muted text-[14px]">{stat.note}</span>
            </dd>
          </div>
        ))}
      </dl>
    </CountUp>

    <div class="border-line bg-panel mt-7 border p-4 md:p-6">
      <p class="sr-only">
        Heatmap: {NUMBER.format(periodXp)} XP dalam {weeks.length} minggu terakhir.
      </p>
      {/* Bisa difokus supaya pengguna keyboard dapat menggulir heatmap di layar sempit. */}
      <div
        role="group"
        aria-label="Heatmap aktivitas, dapat digulir mendatar"
        tabindex={SCROLLABLE_TABINDEX}
        class="overflow-x-auto pb-1"
      >
        <Reveal client:idle effect="cells" className="w-max">
          <div class="flex gap-[3px]" aria-hidden="true">
            {weeks.map((week) => (
              <div data-reveal-item class="flex flex-col gap-[3px]">
                {week.map(({ level, tip }) => (
                  <span data-tip={tip} class:list={[CELL_CLASS, LEVEL_CLASS[level]]} />
                ))}
              </div>
            ))}
          </div>
        </Reveal>
      </div>
      <Tooltip client:idle />
      <div class="text-faint mt-4 flex flex-wrap justify-between gap-3 font-mono text-[12px]">
        <span>
          {NUMBER.format(periodXp)} XP · 12 bulan
          {sinceLabel !== null && ` · dicatat harian sejak ${sinceLabel}`}
        </span>
        <span class="flex items-center gap-[5px]" aria-hidden="true">
          sedikit
          {LEVELS.map((level) => (
            <span class:list={[CELL_CLASS, LEVEL_CLASS[level]]} />
          ))}
          banyak
        </span>
      </div>
    </div>

    <a
      href={PROFILE.htb.profileUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-accent hover:text-ink mt-4 inline-flex min-h-11 items-center text-[14px] underline underline-offset-4"
    >
      Lihat profil Hack The Box<span class="sr-only"> (tab baru)</span>
      <span class="ml-1" aria-hidden="true">
        &nearr;
      </span>
    </a>
  </div>
</section>
