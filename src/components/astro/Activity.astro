---
import { HTB_SAMPLE_COUNTS } from '../../data/htb-sample';
import { heatLevel, toWeeks, type HeatLevel } from '../../lib/heatmap';
import Reveal from '../react/Reveal';
import SectionHeader from './SectionHeader.astro';

// Sampai sync HTB (F9) ada, heatmap memakai data contoh dan diberi label demikian.
const counts = HTB_SAMPLE_COUNTS;
const max = Math.max(...counts);
const weeks = toWeeks(counts.map((count) => heatLevel(count, max)));
const total = counts.reduce((sum, count) => sum + count, 0);

const LEVEL_CLASS: Record<HeatLevel, string> = {
  0: 'bg-heat-0',
  1: 'bg-heat-1',
  2: 'bg-heat-2',
  3: 'bg-heat-3',
  4: 'bg-heat-4',
};
const LEVELS: readonly HeatLevel[] = [0, 1, 2, 3, 4];
const CELL_CLASS = 'rounded-heat size-3';
---

<section id="aktivitas" aria-labelledby="judul-aktivitas" class="container-page">
  <div class="border-line border-t py-16 md:py-26">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <SectionHeader number="03" title="Aktivitas Hack The Box" id="judul-aktivitas" />
      <p class="text-faint font-mono text-[13px]">data contoh · belum tersinkron</p>
    </div>

    <div class="border-line bg-panel mt-7 border p-4 md:p-6">
      <p class="sr-only">
        Heatmap contoh: {total} aktivitas dalam {weeks.length} minggu. Data nyata menyusul.
      </p>
      {/* Bisa difokus supaya pengguna keyboard dapat menggulir heatmap di layar sempit. */}
      <div
        role="group"
        aria-label="Heatmap aktivitas, dapat digulir mendatar"
        tabindex="0"
        class="overflow-x-auto pb-1"
      >
        <Reveal client:idle effect="cells" className="w-max">
          <div class="flex gap-[3px]" aria-hidden="true">
            {weeks.map((week) => (
              <div data-reveal-item class="flex flex-col gap-[3px]">
                {week.map((level) => (
                  <span class:list={[CELL_CLASS, LEVEL_CLASS[level]]} />
                ))}
              </div>
            ))}
          </div>
        </Reveal>
      </div>
      <div
        class="text-faint mt-4 flex flex-wrap justify-between gap-3 font-mono text-[12px]"
        aria-hidden="true"
      >
        <span>{total} aktivitas contoh · 12 bulan</span>
        <span class="flex items-center gap-[5px]">
          sedikit
          {LEVELS.map((level) => (
            <span class:list={[CELL_CLASS, LEVEL_CLASS[level]]} />
          ))}
          banyak
        </span>
      </div>
    </div>
  </div>
</section>
