---
// Pop-up detail di atas <dialog> bawaan browser (Esc, fokus, dan pembaca layar ditangani
// browser). Dibuka oleh elemen `data-dialog-open="<id>"`; lihat Dialogs.tsx.
interface Props {
  id: string;
  /** Label mono kecil di atas judul. */
  label: string;
  title: string;
}

const { id, label, title } = Astro.props;
const titleId = `${id}-judul`;
---

<dialog
  id={id}
  aria-labelledby={titleId}
  class="border-line bg-panel text-ink backdrop:bg-bg/85 m-auto max-h-[calc(100dvh-32px)] w-[min(920px,calc(100vw-32px))] overflow-y-auto border"
>
  <div class="flex flex-col gap-6 p-5 md:p-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-accent mb-2 font-mono text-[12px]">{label}</p>
        <h3 id={titleId} class="text-[26px] leading-[1.15] tracking-[-0.02em] md:text-[32px]">
          {title}
        </h3>
      </div>
      <button
        type="button"
        data-dialog-close
        aria-label="Tutup"
        class="border-line hover:border-accent hover:text-accent inline-flex size-11 shrink-0 items-center justify-center border"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M5 5l14 14M19 5L5 19"></path>
        </svg>
      </button>
    </div>
    <slot />
  </div>
</dialog>
