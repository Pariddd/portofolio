---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Picture } from 'astro:assets';
import heroArt from '../../assets/hero.jpg';
import { PROFILE } from '../../data/profile';

// Tombol CV tidak dirender selama PDF-nya belum di-commit, supaya tidak ada link mati.
const hasCv = existsSync(join(process.cwd(), 'public', PROFILE.cvPath));

const BUTTON_CLASS = 'inline-flex min-h-12 items-center border px-[22px] text-[15px] font-semibold';
// Panel miring dari mockup: sisi kiri atas turun 6%.
const PANEL_CLIP = '[clip-path:polygon(0_6%,100%_0,100%_100%,0_100%)]';
---

<section
  id="top"
  class="container-page grid items-center gap-12 pt-6 pb-16 md:pt-10 md:pb-26 lg:grid-cols-2 lg:gap-14"
>
  <div class="flex flex-col gap-[22px]">
    <p class="text-accent font-mono text-[13px]">{`// ${PROFILE.tagline}`}</p>
    <h1 class="after:text-accent text-[clamp(72px,11vw,168px)] leading-[0.88] tracking-[-0.05em] after:content-['.']">
      {PROFILE.name}
    </h1>
    <p class="text-[22px] leading-[1.3] font-semibold tracking-[-0.01em]">{PROFILE.role}</p>
    <p class="text-muted max-w-[460px]">{PROFILE.summary}</p>
    <div class="flex flex-wrap gap-3">
      <a
        href="#project"
        class:list={[BUTTON_CLASS, 'border-ink bg-ink text-bg hover:border-accent hover:bg-accent']}
      >
        Lihat project
      </a>
      {hasCv && (
        <a
          href={PROFILE.cvPath}
          download
          class:list={[BUTTON_CLASS, 'border-ink text-ink hover:border-accent hover:text-accent']}
        >
          Unduh CV
        </a>
      )}
    </div>
  </div>

  <div class="relative mx-auto flex w-full max-w-[520px] items-center justify-center md:py-8">
    <div
      class="border-line absolute hidden aspect-square w-full rounded-full border border-dashed md:block"
      aria-hidden="true"
    ></div>
    <div class="relative aspect-[44/50] w-[calc(100%-28px)] max-w-[440px]">
      <div
        class:list={[
          'border-ink dark:border-accent absolute top-3.5 -right-3.5 -bottom-3.5 left-3.5 border',
          PANEL_CLIP,
        ]}
        aria-hidden="true"
      ></div>
      <div class:list={['bg-line absolute inset-0 overflow-hidden', PANEL_CLIP]}>
        <Picture
          src={heroArt}
          alt={PROFILE.heroArtAlt}
          formats={['avif', 'webp']}
          widths={[360, heroArt.width]}
          sizes="(min-width: 500px) 440px, calc(100vw - 60px)"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover"
        />
      </div>
      {PROFILE.handle !== null && (
        <dl class="border-line bg-panel absolute bottom-7 -left-2 border px-3.5 py-2.5 font-mono text-[12px] md:-left-7">
          <dt class="text-faint">handle</dt>
          <dd class="font-medium">{PROFILE.handle}</dd>
        </dl>
      )}
    </div>
  </div>
</section>
