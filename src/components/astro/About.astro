---
import { Picture } from 'astro:assets';
import photo from '../../assets/photo.jpg';
import { PROFILE } from '../../data/profile';
import Reveal from '../react/Reveal';
import SectionHeader from './SectionHeader.astro';

const { education } = PROFILE;
const LABEL_CLASS = 'text-faint mb-2 font-mono text-[12px]';
---

<section
  id="tentang"
  aria-labelledby="judul-tentang"
  class="container-page grid gap-8 py-16 md:grid-cols-12 md:py-26"
>
  <div class="md:col-span-12">
    <SectionHeader number="01" title="Tentang saya" id="judul-tentang" />
  </div>

  <div class="border-line bg-panel w-full max-w-[380px] self-start border p-5 md:col-span-5 lg:col-span-4">
    {/* Scan reveal: tirai turun sekali saat foto masuk viewport (lihat Reveal.tsx). */}
    <Reveal client:idle effect="scan" className="bg-line relative aspect-[4/5] overflow-hidden">
      <Picture
        src={photo}
        alt={PROFILE.photoAlt}
        formats={['avif', 'webp']}
        sizes="(min-width: 1024px) 317px, (min-width: 768px) 30vw, 340px"
        widths={[320, photo.width]}
        loading="lazy"
        class="size-full object-cover"
      />
      <div
        data-reveal-item
        class="border-accent bg-panel absolute inset-0 [transform:translateY(101%)] border-t-2"
        aria-hidden="true"
      ></div>
      <div
        data-reveal-loop
        class="border-accent-hi pointer-events-none absolute inset-0 border-t-2 opacity-0"
        aria-hidden="true"
      ></div>
    </Reveal>
    <div class="text-faint mt-4 flex justify-between gap-4 font-mono text-[12px]">
      <span>{PROFILE.accessLabel}</span>
      {PROFILE.handle !== null && <span>{PROFILE.handle}</span>}
    </div>
    <p class="mt-1 text-[22px] leading-[1.3] font-extrabold">{PROFILE.name}</p>
    <p class="text-muted text-[14px]">
      {PROFILE.location}
      {PROFILE.status !== null && ` · ${PROFILE.status}`}
    </p>
  </div>

  <Reveal client:idle effect="rise" className="flex flex-col gap-10 md:col-span-7 lg:col-span-8">
    <p data-reveal-item class="text-[20px] leading-[1.5] tracking-[-0.01em] md:text-[22px]">
      {PROFILE.about}
    </p>
    <dl data-reveal-item class="border-ink grid border-t sm:grid-cols-2">
      <div class="border-line border-b py-5 sm:pr-5">
        <dt class={LABEL_CLASS}>FOKUS</dt>
        {PROFILE.focus.map((item) => (
          <dd class="font-semibold">{item}</dd>
        ))}
      </div>
      <div class="border-line border-b py-5 sm:px-5">
        <dt class={LABEL_CLASS}>PENDIDIKAN</dt>
        <dd class="font-semibold">{education.degree}</dd>
        <dd class="text-muted text-[15px]">
          {education.school}
          {education.startYear !== null && ` · ${education.startYear}–sekarang`}
        </dd>
      </div>
    </dl>
  </Reveal>
</section>
