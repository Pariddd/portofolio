---
import { NAV_LINKS } from '../../data/nav';
import { PROFILE } from '../../data/profile';
import ThemeToggle from './ThemeToggle.astro';
---

<header>
  <div class="container-page flex flex-wrap items-center justify-between gap-x-7 py-3 md:py-6">
    <a
      href="/"
      class="after:text-accent inline-flex min-h-11 items-center text-[18px] font-extrabold after:content-['.']"
    >
      {PROFILE.name}
    </a>
    <nav aria-label="Utama" class="order-last w-full md:order-none md:ml-auto md:w-auto">
      <ul class="-mx-2.5 flex md:mx-0 md:gap-2">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="hover:text-accent inline-flex min-h-11 items-center px-2.5 text-[15px]"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
