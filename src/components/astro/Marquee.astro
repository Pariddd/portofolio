---
import { TOOLS } from '../../data/tools';
import MarqueeMotion from '../react/MarqueeMotion';

// Digerakkan MarqueeMotion. Tiap salinan daftar diakhiri jarak selebar gap, jadi geser
// sejauh satu salinan tepat satu putaran. Di layar lebar island menambah salinan.
const LIST_CLASS = 'flex shrink-0 gap-14 pr-14';
---

<section
  aria-label="Tools yang dipakai"
  class="border-line text-faint relative overflow-hidden border-y font-mono text-[13px]"
>
  <MarqueeMotion client:idle className="py-[18px]">
    <label class="bg-ink text-bg sr-only px-4 py-3 focus-within:not-sr-only focus-within:absolute focus-within:top-1 focus-within:left-2 focus-within:z-10">
      <input type="checkbox" class="mr-2" />
      Jeda gerakan daftar tools
    </label>
    <div data-marquee-track class="flex w-max whitespace-nowrap">
      <ul class={LIST_CLASS}>
        {TOOLS.map((tool) => (
          <li>{tool}</li>
        ))}
      </ul>
      <ul class={LIST_CLASS} aria-hidden="true">
        {TOOLS.map((tool) => (
          <li>{tool}</li>
        ))}
      </ul>
    </div>
  </MarqueeMotion>
</section>
