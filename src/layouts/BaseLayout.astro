---
import Footer from '../components/astro/Footer.astro';
import Navbar from '../components/astro/Navbar.astro';
import BackToTop from '../components/react/BackToTop';
import { PROFILE } from '../data/profile';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** `true` untuk halaman yang tidak boleh diindeks mesin pencari (mis. 404). */
  noindex?: boolean;
}

// Script di <head> adalah satu-satunya inline script yang diizinkan: ia harus jalan
// sebelum paint untuk memasang tema dan menandai bahwa preload tampil (hanya bila JavaScript jalan).
// Jika isinya berubah: `npm run build && npm run check:csp -- --print`, lalu perbarui
// hash di public/_headers.
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Gambar pratinjau saat link dibagikan (1200 × 630). Harus berupa alamat lengkap.
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#eff3f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1213" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={PROFILE.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${PROFILE.fullName} — ${PROFILE.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href="/fonts/schibsted-grotesk-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          // Storage diblokir: ikuti preferensi sistem.
        }
        const dark =
          stored === 'dark' ||
          (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        root.classList.toggle('dark', dark);
        root.classList.add('preloading');
      })();
    </script>
  </head>
  <body>
    <a
      href="#konten"
      class="bg-ink text-bg sr-only px-4 py-3 font-mono text-[13px] focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50"
    >
      Lewati ke konten
    </a>
    <Navbar />
    <main id="konten">
      <slot />
    </main>
    <Footer />
    <BackToTop client:idle />
  </body>
</html>
